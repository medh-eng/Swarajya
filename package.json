{
  "name": "swarajya",
  "private": true,
  "version": "0.0.1",
  "description": "YUDDH: Swarajya — a tactical card game of Chhatrapati Shivaji Maharaj's life and wars, on the YUDDH engine",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/check-refs.mjs . && vitest run",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/convert-assets.mjs",
    "golden": "node legacy/golden.cjs tests/golden/traces.json",
    "check-refs": "node scripts/check-refs.mjs ."
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/tiro-devanagari-hindi": "^5.3.0",
    "gsap": "3.15.0",
    "jsqr": "^1.4.0",
    "pixi.js": "8.22.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "sharp": "^0.34.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
